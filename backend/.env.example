# Скопируй в .env и заполни ключи.
# Без ключей Legion работает на эвристиках + локальном blacklist.

# Google Safe Browsing API key (Cloud Console → Safe Browsing API)
SAFE_BROWSING_API_KEY=

# OpenAI-compatible LLM (DeepSeek / OpenAI / proxy) — для серого коридора
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
